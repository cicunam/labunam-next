{
  "name": "labunam-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test:e2e": "playwright test",
    "fotos": "node --env-file-if-exists=.env scripts/fotos.js",
    "fotos:revisar": "node scripts/revision-fotos/server.mjs",
    "fotos:buscar": "node --env-file-if-exists=.env scripts/revision-fotos/buscar.mjs",
    "format": "prettier \"src/**/*.{js,jsx,css,json}\" \"public/js/*.js\" \"tests/**/*.js\" \"scripts/*.js\" \"eslint-rules/*.js\" \"*.{js,mjs,json}\" \".storybook/*.js\" --write",
    "format:check": "prettier \"src/**/*.{js,jsx,css,json}\" \"public/js/*.js\" \"tests/**/*.js\" \"scripts/*.js\" \"eslint-rules/*.js\" \"*.{js,mjs,json}\" \".storybook/*.js\" --check"
  },
  "dependencies": {
    "mysql2": "^3.24.5",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "sharp": "^0.35.5",
    "storybook": "^10.6.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "type": "module"
}
